@@ -0,0 +1,24 @@
+package tunnel
+
+import (
+	"github.com/quic-go/quic-go/congestion"
+	"testing"
+)
+
+func TestBBRConfigAndIndependentConnections(t *testing.T) {
+	if !CongestionAvailable("bbr") {
+		t.Fatal("BBR was not registered")
+	}
+	reno := NewQUICConfig(QUICOptions{CongestionControl: "reno"})
+	if reno.CongestionControl != nil {
+		t.Fatal("Reno changed")
+	}
+	cfg := NewQUICConfig(QUICOptions{CongestionControl: "bbr"})
+	if cfg.CongestionControl == nil {
+		t.Fatal("BBR not selected")
+	}
+	a, b := cfg.CongestionControl(congestion.InitialPacketSize), cfg.CongestionControl(congestion.InitialPacketSize)
+	if a == b || a.GetCongestionWindow() <= 0 || b.GetCongestionWindow() <= 0 {
+		t.Fatal("connections share state or have no window")
+	}
+}
