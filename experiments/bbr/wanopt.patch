+	"wanopt/internal/congestion/bbr"
+)
+
+func init() {
+	bbrConfigurer = func(cfg *quic.Config) {
+		cfg.CongestionControl = func(size congestion.ByteCount) congestion.CongestionControl {
+			return bbr.NewBbrSender(bbr.DefaultClock{}, size, bbr.ProfileStandard)
+		}
+	}
+}
