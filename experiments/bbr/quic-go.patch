@@ -0,0 +1,56 @@
+package ackhandler
+
+import (
+	ext "github.com/quic-go/quic-go/congestion"
+	"github.com/quic-go/quic-go/internal/monotime"
+	"github.com/quic-go/quic-go/internal/protocol"
+	"github.com/quic-go/quic-go/internal/utils"
+	"testing"
+)
+
+type recoveryController struct {
+	*eventController
+	least    ext.PacketNumber
+	timeouts []bool
+	spurious ext.PacketNumber
+}
+
+func (c *recoveryController) OnCongestionEventExWithLeastUnacked(prior ext.ByteCount, now monotime.Time, a []ext.AckedPacketInfo, l []ext.LostPacketInfo, least ext.PacketNumber) {
+	c.least = least
+	c.OnCongestionEventEx(prior, now, a, l)
+}
+func (c *recoveryController) OnRetransmissionTimeout(retransmitted bool) {
+	c.timeouts = append(c.timeouts, retransmitted)
+}
+func (c *recoveryController) OnSpuriousLoss(pn ext.PacketNumber) { c.spurious = pn }
+func (c *recoveryController) SetMaxDatagramSize(n ext.ByteCount) { c.size = n }
+func TestAdapterExactHistoryTimeoutAndSpuriousLoss(t *testing.T) {
+	h := NewSentPacketHandler(0, 1200, utils.NewRTTStats(), &utils.ConnectionStats{}, false, false, nil, protocol.PerspectiveClient, nil, utils.DefaultLogger).(*sentPacketHandler)
+	c := &recoveryController{eventController: &eventController{size: 1200}}
+	ConfigureCongestion(h, func(ext.ByteCount) ext.CongestionControl { return c }, 1200)
+	h.hist.firstPacketNumber = 2
+	h.hist.highestPacketNumber = 100
+	a := h.congestion.(*ccAdapter)
+	now := monotime.Now()
+	a.OnPacketAcked(100, 1200, 3600, now)
+	h.flushCongestion(3600, now)
+	if c.least != 2 {
+		t.Fatal("adapter guessed ACK threshold instead of transport history")
+	}
+	a.OnRetransmissionTimeout(false)
+	a.OnRetransmissionTimeout(true)
+	a.OnSpuriousLoss(9)
+	if len(c.timeouts) != 2 || c.timeouts[0] || !c.timeouts[1] || c.spurious != 9 {
+		t.Fatal("recovery notification lost")
+	}
+	a.SetMaxDatagramSize(1400)
+	if h.connStats.CongestionWindow.Load() != 44800 {
+		t.Fatal("MTU change left stale window stats")
+	}
+	h.hist.firstPacketNumber = protocol.InvalidPacketNumber
+	a.OnCongestionEvent(1, 1200, 1200)
+	h.flushCongestion(1200, now)
+	if c.least != 101 {
+		t.Fatal("empty history watermark incorrect")
+	}
+}
