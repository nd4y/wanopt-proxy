@@ -0,0 +1,47 @@
+package ackhandler
+
+import (
+	ext "github.com/quic-go/quic-go/congestion"
+	"github.com/quic-go/quic-go/internal/monotime"
+	"github.com/quic-go/quic-go/internal/protocol"
+	"github.com/quic-go/quic-go/internal/utils"
+	"github.com/quic-go/quic-go/internal/wire"
+	"testing"
+	"time"
+)
+
+type sendFlightController struct {
+	*eventController
+	flight []ext.ByteCount
+}
+
+func (c *sendFlightController) OnPacketSent(_ monotime.Time, n ext.ByteCount, _ ext.PacketNumber, _ ext.ByteCount, _ bool) {
+	c.flight = append(c.flight, n)
+}
+func (c *sendFlightController) MaybeExitSlowStart() {}
+func TestAdapterUsesPreSendFlightThroughRealHandler(t *testing.T) {
+	h := NewSentPacketHandler(0, 1200, utils.NewRTTStats(), &utils.ConnectionStats{}, false, false, nil, protocol.PerspectiveClient, nil, utils.DefaultLogger).(*sentPacketHandler)
+	c := &sendFlightController{eventController: &eventController{size: 1200}}
+	ConfigureCongestion(h, func(ext.ByteCount) ext.CongestionControl { return c }, 1200)
+	now := monotime.Now()
+	send := func(pn protocol.PacketNumber, size protocol.ByteCount, eliciting bool) {
+		var frames []Frame
+		if eliciting {
+			frames = []Frame{{Frame: &wire.PingFrame{}}}
+		}
+		h.SentPacket(now, pn, protocol.InvalidPacketNumber, nil, frames, protocol.Encryption1RTT, protocol.ECNNon, size, false, false)
+	}
+	send(0, 1200, true)
+	send(1, 200, false)
+	send(2, 1000, true)
+	if _, err := h.ReceivedAck(&wire.AckFrame{AckRanges: []wire.AckRange{{Smallest: 0, Largest: 2}}}, protocol.Encryption1RTT, now.Add(100*time.Millisecond)); err != nil {
+		t.Fatal(err)
+	}
+	send(3, 1300, true)
+	want := []ext.ByteCount{0, 1200, 1200, 0}
+	for i, n := range want {
+		if c.flight[i] != n {
+			t.Fatalf("packet %d: BBR received flight=%d, want pre-send %d; all=%v", i, c.flight[i], n, c.flight)
+		}
+	}
+}
