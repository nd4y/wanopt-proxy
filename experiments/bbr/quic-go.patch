diff --git a/internal/ackhandler/cc_adapter.go b/internal/ackhandler/cc_adapter.go
new file mode 100644
index 00000000..c5adaa60
--- /dev/null
+++ b/internal/ackhandler/cc_adapter.go
@@ -0,0 +1,124 @@
+package ackhandler
+
+import (
+	"github.com/quic-go/quic-go/congestion"
+	cgInternal "github.com/quic-go/quic-go/internal/congestion"
+	"github.com/quic-go/quic-go/internal/monotime"
+	"github.com/quic-go/quic-go/internal/protocol"
+	"github.com/quic-go/quic-go/internal/utils"
+)
+
+var _ cgInternal.SendAlgorithmWithDebugInfos = &ccAdapter{}
+
+type ccAdapter struct {
+	CC    congestion.CongestionControl
+	acked []congestion.AckedPacketInfo
+	lost  []congestion.LostPacketInfo
+	stats *utils.ConnectionStats
+}
+
+func (a *ccAdapter) TimeUntilSend(bytesInFlight protocol.ByteCount) monotime.Time {
+	return a.CC.TimeUntilSend(congestion.ByteCount(bytesInFlight))
+}
+
+func (a *ccAdapter) HasPacingBudget(now monotime.Time) bool {
+	return a.CC.HasPacingBudget(now)
+}
+
+func (a *ccAdapter) OnPacketSent(sentTime monotime.Time, bytesInFlight protocol.ByteCount, packetNumber protocol.PacketNumber, bytes protocol.ByteCount, isRetransmittable bool) {
+	// Upstream reports post-send flight; external samplers need pre-send flight.
+	if isRetransmittable {
+		bytesInFlight = max(0, bytesInFlight-bytes)
+	}
+	a.CC.OnPacketSent(sentTime, congestion.ByteCount(bytesInFlight), congestion.PacketNumber(packetNumber), congestion.ByteCount(bytes), isRetransmittable)
+}
+
+func (a *ccAdapter) CanSend(bytesInFlight protocol.ByteCount) bool {
+	return a.CC.CanSend(congestion.ByteCount(bytesInFlight))
+}
+
+func (a *ccAdapter) MaybeExitSlowStart() {
+	a.CC.MaybeExitSlowStart()
+}
+
+func (a *ccAdapter) OnPacketAcked(number protocol.PacketNumber, ackedBytes protocol.ByteCount, priorInFlight protocol.ByteCount, eventTime monotime.Time) {
+	a.CC.OnPacketAcked(congestion.PacketNumber(number), congestion.ByteCount(ackedBytes), congestion.ByteCount(priorInFlight), eventTime)
+	if _, ok := a.CC.(congestion.CongestionControlEx); ok {
+		a.acked = append(a.acked, congestion.AckedPacketInfo{PacketNumber: congestion.PacketNumber(number), BytesAcked: congestion.ByteCount(ackedBytes), ReceivedTime: eventTime})
+	}
+}
+
+func (a *ccAdapter) OnCongestionEvent(number protocol.PacketNumber, lostBytes protocol.ByteCount, priorInFlight protocol.ByteCount) {
+	// With an external controller, accounting belongs to the adapter.
+	// ECN-only notifications have no lost bytes and must not invent a loss.
+	if lostBytes > 0 {
+		a.stats.PacketsLost.Add(1)
+		a.stats.BytesLost.Add(uint64(lostBytes))
+	}
+	a.CC.OnCongestionEvent(congestion.PacketNumber(number), congestion.ByteCount(lostBytes), congestion.ByteCount(priorInFlight))
+	if _, ok := a.CC.(congestion.CongestionControlEx); ok && lostBytes > 0 {
+		a.lost = append(a.lost, congestion.LostPacketInfo{PacketNumber: congestion.PacketNumber(number), BytesLost: congestion.ByteCount(lostBytes)})
+	}
+}
+
+func (a *ccAdapter) OnRetransmissionTimeout(packetsRetransmitted bool) {
+	a.CC.OnRetransmissionTimeout(packetsRetransmitted)
+}
+
+func (a *ccAdapter) SetMaxDatagramSize(size protocol.ByteCount) {
+	a.CC.SetMaxDatagramSize(congestion.ByteCount(size))
+	a.stats.CongestionWindow.Store(uint64(a.CC.GetCongestionWindow()))
+}
+
+func (a *ccAdapter) InSlowStart() bool {
+	return a.CC.InSlowStart()
+}
+
+func (a *ccAdapter) InRecovery() bool {
+	return a.CC.InRecovery()
+}
+
+func (a *ccAdapter) GetCongestionWindow() protocol.ByteCount {
+	return protocol.ByteCount(a.CC.GetCongestionWindow())
+}
+
+// ConfigureCongestion is called only before the connection loop starts, or by
+// that loop during path migration. There is no concurrent live replacement.
+func ConfigureCongestion(handler SentPacketHandler, factory func(congestion.ByteCount) congestion.CongestionControl, size protocol.ByteCount) {
+	if factory == nil {
+		return
+	}
+	h := handler.(*sentPacketHandler)
+	h.congestionFactory = factory
+	cc := factory(congestion.ByteCount(size))
+	cc.SetRTTStatsProvider(h.rttStats)
+	h.congestion = &ccAdapter{CC: cc, stats: h.connStats}
+	h.connStats.CongestionWindow.Store(uint64(cc.GetCongestionWindow()))
+}
+func (a *ccAdapter) OnSpuriousLoss(number protocol.PacketNumber) {
+	if cc, ok := a.CC.(interface{ OnSpuriousLoss(congestion.PacketNumber) }); ok {
+		cc.OnSpuriousLoss(congestion.PacketNumber(number))
+	}
+}
+func (h *sentPacketHandler) flushCongestion(prior protocol.ByteCount, now monotime.Time) {
+	a, ok := h.congestion.(*ccAdapter)
+	if !ok {
+		return
+	}
+	if ex, ok := a.CC.(congestion.CongestionControlEx); ok && (len(a.acked) > 0 || len(a.lost) > 0) {
+		if exact, ok := a.CC.(interface {
+			OnCongestionEventExWithLeastUnacked(congestion.ByteCount, monotime.Time, []congestion.AckedPacketInfo, []congestion.LostPacketInfo, congestion.PacketNumber)
+		}); ok {
+			least := h.hist.FirstPacketNumber()
+			if least == protocol.InvalidPacketNumber {
+				least = h.hist.highestPacketNumber + 1
+			}
+			exact.OnCongestionEventExWithLeastUnacked(congestion.ByteCount(prior), now, a.acked, a.lost, congestion.PacketNumber(least))
+		} else {
+			ex.OnCongestionEventEx(congestion.ByteCount(prior), now, a.acked, a.lost)
+		}
+	}
+	a.acked = a.acked[:0]
+	a.lost = a.lost[:0]
+	h.connStats.CongestionWindow.Store(uint64(a.CC.GetCongestionWindow()))
+}
