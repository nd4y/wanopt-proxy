index 00000000..d7f3d4d2
--- /dev/null
+++ b/internal/ackhandler/cc_adapter_stats_test.go
@@ -0,0 +1,26 @@
+package ackhandler
+
+import (
+	"github.com/quic-go/quic-go/internal/monotime"
+	"github.com/quic-go/quic-go/internal/protocol"
+	"github.com/quic-go/quic-go/internal/utils"
+	"testing"
+)
+
+func TestAdapterReportsDeclaredPacketAndByteLoss(t *testing.T) {
+	stats := &utils.ConnectionStats{}
+	c := &eventController{size: 1200}
+	a := &ccAdapter{CC: c, stats: stats}
+	a.OnCongestionEvent(protocol.PacketNumber(1), 1200, 2400)
+	a.OnCongestionEvent(protocol.PacketNumber(2), 800, 1200)
+	a.OnCongestionEvent(protocol.InvalidPacketNumber, 0, 400) // ECN is not a lost packet.
+	a.OnPacketAcked(protocol.PacketNumber(3), 400, 400, monotime.Now())
+	if stats.PacketsLost.Load() != 2 || stats.BytesLost.Load() != 2000 {
+		t.Fatalf("loss stats absent/wrong: packets=%d bytes=%d", stats.PacketsLost.Load(), stats.BytesLost.Load())
+	}
+	// These are cumulative declaration statistics, not outstanding lost data.
+	a.OnSpuriousLoss(1)
+	if stats.PacketsLost.Load() != 2 || stats.BytesLost.Load() != 2000 {
+		t.Fatal("spurious-loss notification rewrote declaration history")
+	}
+}
diff --git a/internal/ackhandler/cc_adapter_test.go b/internal/ackhandler/cc_adapter_test.go
new file mode 100644
index 00000000..abe32ac7
--- /dev/null
+++ b/internal/ackhandler/cc_adapter_test.go
@@ -0,0 +1,68 @@
+package ackhandler
+
+import (
+	ext "github.com/quic-go/quic-go/congestion"
+	"github.com/quic-go/quic-go/internal/monotime"
+	"github.com/quic-go/quic-go/internal/protocol"
+	"github.com/quic-go/quic-go/internal/utils"
+	"testing"
+)
+
+type eventController struct {
+	ext.CongestionControl
+	rtt   ext.RTTStatsProvider
+	size  ext.ByteCount
+	calls int
+	acked []ext.AckedPacketInfo
+	lost  []ext.LostPacketInfo
+	prior ext.ByteCount
+}
+
+func (c *eventController) SetRTTStatsProvider(r ext.RTTStatsProvider) { c.rtt = r }
+func (c *eventController) GetCongestionWindow() ext.ByteCount         { return 32 * c.size }
+func (c *eventController) OnPacketAcked(ext.PacketNumber, ext.ByteCount, ext.ByteCount, monotime.Time) {
+}
+func (c *eventController) OnCongestionEvent(ext.PacketNumber, ext.ByteCount, ext.ByteCount) {}
+func (c *eventController) OnCongestionEventEx(prior ext.ByteCount, _ monotime.Time, a []ext.AckedPacketInfo, l []ext.LostPacketInfo) {
+	c.calls++
+	c.prior = prior
+	c.acked = append([]ext.AckedPacketInfo(nil), a...)
+	c.lost = append([]ext.LostPacketInfo(nil), l...)
+}
+func TestExternalControllerBatchAndMigration(t *testing.T) {
+	h := NewSentPacketHandler(0, 1200, utils.NewRTTStats(), &utils.ConnectionStats{}, false, false, nil, protocol.PerspectiveClient, nil, utils.DefaultLogger).(*sentPacketHandler)
+	original := h.congestion
+	ConfigureCongestion(h, nil, 1200)
+	if h.congestion != original {
+		t.Fatal("nil factory replaced Reno")
+	}
+	var created []*eventController
+	factory := func(size ext.ByteCount) ext.CongestionControl {
+		c := &eventController{size: size}
+		created = append(created, c)
+		return c
+	}
+	ConfigureCongestion(h, factory, 1200)
+	a := h.congestion.(*ccAdapter)
+	now := monotime.Now()
+	a.OnPacketAcked(4, 1200, 3600, now)
+	a.OnCongestionEvent(2, 1200, 3600)
+	h.flushCongestion(3600, now)
+	c := created[0]
+	if c.rtt != h.rttStats || c.calls != 1 || c.prior != 3600 || len(c.acked) != 1 || c.acked[0].PacketNumber != 4 || len(c.lost) != 1 || c.lost[0].PacketNumber != 2 {
+		t.Fatal("batch or RTT provider mismatch")
+	}
+	h.flushCongestion(0, now)
+	if c.calls != 1 {
+		t.Fatal("batch replayed")
+	}
+	a.OnCongestionEvent(5, 1200, 1200)
+	h.flushCongestion(1200, now)
+	if c.calls != 2 || len(c.acked) != 0 || len(c.lost) != 1 {
+		t.Fatal("loss-only batch missing")
+	}
+	h.MigratedPath(now, 1280)
+	if len(created) != 2 || created[1].size != 1280 || created[1].rtt != h.rttStats || h.connStats.CongestionWindow.Load() != 40960 {
+		t.Fatal("migration did not reset controller and window")
+	}
+}
